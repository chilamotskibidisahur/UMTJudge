{
  "name": "umtjudge",
  "version": "1.6.6",
  "description": "UMTJudge",
  "main": "electron/main.cjs",
  "scripts": {
    "server": "node server/index.cjs",
    "dev:ui": "vite",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,UI\" -c \"cyan,magenta\" \"node server/index.cjs\" \"vite\"",
    "electron:dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,UI,APP\" -c \"cyan,magenta,green\" \"node server/index.cjs\" \"vite\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "build": "vite build",
    "build:exe": "vite build && electron-builder --win --x64",
    "build:portable": "vite build && electron-builder --win portable --x64",
    "build:linux": "vite build && electron-builder --linux --x64",
    "build:appimage": "vite build && electron-builder --linux AppImage --x64",
    "build:pacman": "vite build && electron-builder --linux pacman --x64",
    "dist": "vite build && electron-builder --win --x64",
    "preview": "vite preview",
    "start": "concurrently -k -p \"[{name}]\" -n \"SERVER,UI\" -c \"cyan,magenta\" \"node server/index.cjs\" \"vite preview\"",
    "build:deb": "node scripts/build-deb.cjs",
    "build:linux:dir": "vite build && electron-builder --linux --dir --x64",
    "test": "node --test tests/*.test.cjs",
    "tunnel": "node scripts/tunnel.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src server electron tests",
    "sign:update": "node scripts/sign-update.cjs",
    "db:migrate": "node server/database/migrate-from-json.cjs"
  },
  "build": {
    "appId": "com.umtjudge.lan",
    "productName": "UMTJudge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}_Setup_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "pacman",
        "deb",
        "tar.gz"
      ],
      "category": "Education",
      "maintainer": "UMTJudge Team <admin@umtjudge.lan>",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "xdg-utils"
      ]
    },
    "pacman": {
      "depends": [
        "c-ares",
        "ffmpeg",
        "gtk3",
        "libevent",
        "libvpx",
        "libxslt",
        "libxss",
        "minizip",
        "nss",
        "re2",
        "snappy",
        "libnotify"
      ]
    },
    "npmRebuild": false
  },
  "keywords": [],
  "author": "UMTJudge Team <admin@umtjudge.lan>",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "argon2": "0.45.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dompurify": "3.4.16",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sanitize-html": "2.18.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "xlsx": "^0.18.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "docx": "^9.9.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
