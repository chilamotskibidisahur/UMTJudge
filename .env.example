# ==============================================================================
# UMTJudge — Environment Configuration Template
# ==============================================================================

# Cấu hình máy chủ & Tên miền
PORT=4000
NODE_ENV=production
DOMAIN=your-domain.com
APP_URL=https://your-domain.com

# Tài khoản Quản trị viên (Tự động khởi tạo ngay khi chạy máy chủ lần đầu)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=phatt123

# Máy chấm bài (Docker Sandbox & Số worker song song)
JUDGE_WORKERS=2
DOCKER_SANDBOX=true

# Chế độ Cơ sở dữ liệu: 'postgres' (khuyên dùng trên VPS) hoặc 'json' (chạy offline)
SCHOOLJUDGE_DB_MODE=postgres

# Kết nối PostgreSQL (Trùng khớp cấu hình trong docker-compose.yml)
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=umtjudge
PG_USER=umtjudge_admin
PG_PASSWORD=umtjudge_secret_2026
